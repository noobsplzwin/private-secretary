node_modules/
# Cockpit React app build output (npm run cockpit:build).
relay/cockpit/web/dist/
state/
state-demo/
# Frozen eval corpus = a copy of the real shadow log (real chat content).
# The aggregate baseline reports in eval/*.json|md ARE committed — they hold
# only counts, no message text.
eval/replay-corpus/
# L2A bench data: ground truth carries real names + business facts, the frozen
# corpus carries real chat text, detail reports quote both. NEVER commit.
# Aggregate scorecards (eval/l2a-reports/scorecard-*.json) hold counts only
# and ARE committed.
eval/ground-truth.yaml
eval/l2a-corpus/
eval/l2a-reports/detail-*
.gstack/
*.log
.DS_Store

# Sensitive — local-only, NEVER commit (financing/equity/gov/internal-member intel,
# the Leo decision profile, and personal To-Do data). Per Leo, 2026-06-20.
projects/
todo-export/todo_export.*
todo-export/todo_index.json

# Secret — .codex MCP config holds a live API key; never commit.
.codex/
# Vendored third-party agent skills (not this project's source).
.agents/
# Scratch WeChat exploration scripts (throwaway, run with tsx).
wx-*.mts
smoke-wx.mts

# Per-user identity: whose accounts this instance reads. NEVER commit.
config/identity.json

# Personal LLM/backend preferences written by the cockpit Settings screen.
# Not a secret (secrets live in the Keychain), but still per-owner config.
config/secretary-settings.json
config/tools.json

# Personas are dossiers on real people — never commit them.
personas/*.yaml
personas/_backup*/
# The owner's matter registry: business facts. NEVER commit.
config/matters.yaml
personas/_staged/
!personas/_example/

# Owner-specific business facts injected into prompts. NEVER commit.
config/business-context.md

# Owner voice profile: learned from real DMs. NEVER commit.
config/owner-voice.md

# Claude Code's per-machine permission decisions. It rewrites this file every
# time a permission is granted, so tracking it meant any install where the
# owner opened Claude Code went permanently dirty — and a dirty checkout makes
# the updater refuse, silently, forever. Claude Code's own convention is that
# settings.local.json is the not-checked-in half of settings.json.
.claude/settings.local.json

# Kimi CLI local workspace: review notes, chat records, intermediate materials.
# Local only — NEVER commit.
.kimi-code/
.kimi/
